# Normalize line endings to LF in both the repository and the working tree.
# Prevents CRLF checkouts on Windows, which conflict with .editorconfig and
# prettier (endOfLine: lf) and cause phantom "modified" git status entries.
* text=auto eol=lf

# Shell scripts must strictly use LF to execute on macOS/Linux
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files must strictly use CRLF to execute on Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Data & Configuration Formats
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf