# Example environment for `uv run calib-agent-server`
# (alternatively fill these in the web UI Configure card).
DISPLAY_HOST=splitflap.local
# OpenAI-compatible endpoint (default: OpenCode Go — key from OpenCode Zen).
# Other presets you can paste:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1  (needs local model with vision)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_API_KEY=sk-...
# Optional:
# HARNESS_PORT=8000
# CAMERA_INDEX=0
